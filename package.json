{
  "name": "storykids-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "dev:full": "astro build && wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply storykids --local",
    "db:migrate:remote": "wrangler d1 migrations apply storykids --remote",
    "check:worker": "tsc -p src/worker/tsconfig.json"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20261002.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.146.0"
  }
}
