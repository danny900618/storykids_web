---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="找不到頁面">
  <section class="container-page py-24 text-center">
    <p class="text-6xl font-bold text-brand-500">404</p>
    <h1 class="mt-4 text-2xl font-bold">找不到這個頁面</h1>
    <p class="mt-3 text-ink-500">網站已經改版，頁面位置可能有所調整。</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn-primary">回到首頁</a>
      <a href="/news" class="btn-outline">最新消息</a>
    </div>
  </section>
</BaseLayout>
