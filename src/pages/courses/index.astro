---
// 課程介紹總覽：依課程類別分組（類別與排序由後台「課程類別」管理）
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import CourseCard from '../../components/CourseCard.astro';
import { getCourseGroups } from '../../lib/content';

const groups = await getCourseGroups();
---

<BaseLayout title="課程介紹">
  <PageHeader title="課程介紹" subtitle="依孩子的年齡與需求，選擇適合的班別" crumbs={[{ label: '課程介紹', href: '/courses' }]} />
  <div class="container-page space-y-14 py-12">
    {
      groups.map((g) => (
        <section id={g.title} class="scroll-mt-28">
          <h2 class="section-title">
            {g.id ? <a href={`/courses/category/${g.id}`} class="hover:text-brand-700">{g.title}</a> : g.title}
          </h2>
          {g.description && <p class="mt-2 text-ink-500">{g.description}</p>}
          <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {g.courses.map((course) => <CourseCard course={course} />)}
          </div>
        </section>
      ))
    }
    {groups.length === 0 && <p class="text-ink-500">課程資訊整理中。</p>}
  </div>
</BaseLayout>
