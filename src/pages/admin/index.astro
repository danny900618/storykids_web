---
// 報名管理後台：/admin（Worker 驗證登入後才會回傳這個頁面，資料一律透過 /api/admin/* 取得）
import '../../styles/global.css';
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>報名管理｜故事講堂</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="bg-slate-50 text-ink-900">
    <header class="sticky top-0 z-30 border-b border-black/5 bg-white">
      <div class="mx-auto flex max-w-[1400px] flex-wrap items-center gap-3 px-4 py-3">
        <h1 class="text-lg font-bold">故事講堂｜報名管理</h1>
        <span id="mode-badge" class="hidden rounded-full bg-yellow-100 px-3 py-1 text-xs font-bold text-yellow-800"></span>
        <div class="ml-auto flex flex-wrap items-center gap-3 text-sm">
          <span id="actor" class="text-ink-500"></span>
          <span id="sms-points" class="hidden text-ink-500"></span>
          <button type="button" id="test-email" class="rounded-lg border border-black/15 px-3 py-1 hover:bg-slate-100">寄測試信</button>
          <button type="button" id="test-sms" class="rounded-lg border border-black/15 px-3 py-1 hover:bg-slate-100">發測試簡訊</button>
          <a href="/cms" target="_blank" class="text-brand-700 hover:underline">內容管理（課程與時段設定）</a>
          <a href="/" target="_blank" class="text-brand-700 hover:underline">網站首頁</a>
        </div>
      </div>
    </header>

    <main class="mx-auto max-w-[1400px] space-y-6 px-4 py-6">
      <!-- CMS 已刪除但仍有報名的時段 -->
      <p id="orphans" class="hidden rounded-xl bg-red-50 p-3 text-sm text-red-700"></p>

      <!-- 篩選 -->
      <section class="rounded-2xl bg-white p-4 shadow-sm ring-1 ring-black/5">
        <form id="filters" class="flex flex-wrap items-end gap-3">
          <label class="text-sm">來源
            <select name="source" class="mt-1 block rounded-lg border border-black/15 px-3 py-2">
              <option value="">全部</option><option value="new">新網站報名</option><option value="legacy">舊站匯入</option>
            </select>
          </label>
          <label class="text-sm">舊站梯次
            <select name="term" class="mt-1 block rounded-lg border border-black/15 px-3 py-2"><option value="">全部梯次</option></select>
          </label>
          <label class="text-sm">時段
            <select name="session" class="mt-1 block rounded-lg border border-black/15 px-3 py-2"><option value="">全部時段</option></select>
          </label>
          <label class="text-sm">正取／候補
            <select name="admission" class="mt-1 block rounded-lg border border-black/15 px-3 py-2">
              <option value="">全部</option><option>正取</option><option>候補</option>
            </select>
          </label>
          <label class="text-sm">狀態
            <select name="status" class="mt-1 block rounded-lg border border-black/15 px-3 py-2"><option value="">全部狀態</option><option>需人工確認</option><option>逾期未繳</option></select>
          </label>
          <label class="text-sm">搜尋
            <input name="q" placeholder="姓名、電話、Email、學校、課程、帳號、編號" class="mt-1 block w-64 rounded-lg border border-black/15 px-3 py-2" />
          </label>
          <button class="rounded-lg bg-brand-600 px-4 py-2 font-bold text-white hover:bg-brand-700">查詢</button>
          <button type="button" id="export" class="rounded-lg border border-brand-600 px-4 py-2 font-bold text-brand-700 hover:bg-brand-50">匯出 Excel（CSV）</button>
          <span id="count" class="ml-auto text-sm text-ink-500"></span>
        </form>
      </section>

      <!-- 報名列表 -->
      <section class="overflow-x-auto rounded-2xl bg-white shadow-sm ring-1 ring-black/5">
        <table class="w-full min-w-[1200px] text-left text-sm">
          <thead class="bg-slate-100 text-ink-500">
            <tr>
              <th class="px-3 py-3">編號</th><th class="px-3 py-3">報名時間</th><th class="px-3 py-3">課程時段</th>
              <th class="px-3 py-3">學生／家長</th><th class="px-3 py-3">學校／年級</th><th class="px-3 py-3">聯絡方式</th>
              <th class="px-3 py-3">正取／候補</th><th class="px-3 py-3">狀態</th><th class="px-3 py-3">金額／繳費帳號</th><th class="px-3 py-3">操作</th>
            </tr>
          </thead>
          <tbody id="rows" class="divide-y divide-black/5"></tbody>
        </table>
        <p id="empty" class="hidden p-8 text-center text-ink-500">沒有符合條件的報名</p>
      </section>

      <!-- 操作紀錄：誰在什麼時候做了什麼 -->
      <section class="rounded-2xl bg-white p-4 shadow-sm ring-1 ring-black/5">
        <div class="flex flex-wrap items-center gap-3">
          <h2 class="font-bold">操作紀錄</h2>
          <select id="audit-actor" class="rounded-lg border border-black/15 px-3 py-1.5 text-sm"><option value="">所有使用者</option></select>
          <button type="button" id="audit-refresh" class="rounded-lg border border-black/15 px-3 py-1.5 text-sm hover:bg-slate-100">重新整理</button>
          <span class="text-xs text-ink-500">使用密碼登入時，「使用者」為登入視窗填的帳號，建議每個人填自己的名字</span>
        </div>
        <div class="mt-3 overflow-x-auto">
          <table class="w-full min-w-[800px] text-left text-sm">
            <thead class="bg-slate-100 text-ink-500">
              <tr><th class="px-3 py-2">時間</th><th class="px-3 py-2">使用者</th><th class="px-3 py-2">動作</th><th class="px-3 py-2">報名</th><th class="px-3 py-2">內容</th></tr>
            </thead>
            <tbody id="audit-rows" class="divide-y divide-black/5"></tbody>
          </table>
        </div>
        <button type="button" id="audit-more" class="mt-3 hidden w-full rounded-lg border border-black/15 py-2 text-sm hover:bg-slate-100">載入更多</button>
      </section>
    </main>

    <!-- 報名資料：點學生姓名開啟，可修改家長填錯的資料與優待金額 -->
    <dialog id="profile" class="m-auto w-[min(760px,95vw)] rounded-2xl p-0 backdrop:bg-black/40">
      <form id="profile-form" class="flex max-h-[90vh] flex-col">
        <div class="flex items-center justify-between border-b border-black/5 px-5 py-3">
          <h3 class="font-bold" id="profile-title"></h3>
          <button type="button" class="rounded-lg px-3 py-1 hover:bg-slate-100" data-close-profile>關閉</button>
        </div>
        <div class="space-y-5 overflow-y-auto p-5 text-sm">
          <dl id="profile-info" class="grid gap-x-6 gap-y-2 rounded-xl bg-slate-50 p-4 sm:grid-cols-2"></dl>
          <div id="profile-fields" class="grid gap-4 sm:grid-cols-2"></div>
          <div class="rounded-xl bg-yellow-50 p-4">
            <label class="block font-bold">優待金額（元）
              <input name="discount_amount" type="number" min="0" step="1" class="mt-1 block w-48 rounded-lg border border-black/15 bg-white px-3 py-2" />
            </label>
            <p class="mt-1 text-xs text-ink-500">只做紀錄與顯示（例如與家長私下談好的優惠），不會改變應繳金額與繳費帳號。</p>
          </div>
          <p id="profile-error" class="hidden rounded-lg bg-red-50 p-3 text-red-700"></p>
        </div>
        <div class="flex justify-end gap-2 border-t border-black/5 px-5 py-3">
          <button type="button" class="rounded-lg border border-black/15 px-4 py-2 hover:bg-slate-100" data-close-profile>取消</button>
          <button class="rounded-lg bg-brand-600 px-4 py-2 font-bold text-white hover:bg-brand-700">儲存</button>
        </div>
      </form>
    </dialog>

    <!-- 單筆紀錄（通知、入帳、操作） -->
    <dialog id="history" class="m-auto w-[min(800px,95vw)] rounded-2xl p-0 backdrop:bg-black/40">
      <div class="flex items-center justify-between border-b border-black/5 px-5 py-3">
        <h3 class="font-bold" id="history-title"></h3>
        <button type="button" class="rounded-lg px-3 py-1 hover:bg-slate-100" data-close>關閉</button>
      </div>
      <div id="history-body" class="max-h-[70vh] space-y-6 overflow-y-auto p-5 text-sm"></div>
    </dialog>

    <script>
      interface Reg {
        id: number; session_code: string; course_title: string; session_name: string; student_name: string; parent_name: string;
        school: string | null; grade: string | null; phone: string; email: string; note: string | null; admission: string; status: string;
        gender: string | null; tel: string | null; zip: string | null; address: string | null; diet: string | null; discount_amount: number | null;
        agreed_policies: string | null; legacy_id: number | null; legacy_term: string | null; legacy_va: string | null;
        amount: number; va_account: string | null; va_expires_at: string | null; paid_amount: number | null; paid_at: string | null;
        review_note: string | null; created_at: string; expired: boolean;
      }
      interface SessionInfo { code: string; name: string; course_title: string; capacity: number; taken: number; waitlist: number; open: boolean; price: number }

      const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
      const esc = (s: unknown) => String(s ?? '').replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
      const money = (n: number | null) => (n == null ? '' : `NT$ ${n.toLocaleString('en-US')}`);
      const tw = (iso: string | null) =>
        iso ? new Date(iso).toLocaleString('zh-TW', { timeZone: 'Asia/Taipei', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hour12: false }) : '';

      let config: { actor: string; payment_mode: string; mail_mode: string; sms_mode: string; statuses: string[]; sms_points: number | null };
      const filters = $<HTMLFormElement>('filters');

      async function api<T>(path: string, init?: RequestInit): Promise<T> {
        const res = await fetch(`/api/admin${path}`, { ...init, headers: { 'Content-Type': 'application/json', ...init?.headers } });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error((data as { error?: string }).error || `錯誤 ${res.status}`);
        return data as T;
      }

      const query = () => new URLSearchParams(Object.entries(Object.fromEntries(new FormData(filters))).filter(([, v]) => v) as [string, string][]);

      async function loadSessions() {
        const { sessions, orphans, legacy_terms } = await api<{ sessions: SessionInfo[]; orphans: string[]; legacy_terms: { term: string; n: number }[] }>('/sessions');
        const sel = filters.elements.namedItem('session') as HTMLSelectElement;
        const current = sel.value;
        sel.innerHTML = '<option value="">全部時段</option>' + [...sessions.map((s) => [s.code, `${s.course_title}｜${s.name}（正取 ${s.taken}/${s.capacity}${s.waitlist ? `・候補 ${s.waitlist}` : ''}${s.open ? '' : '・暫停報名'}）`]), ...orphans.map((o) => [o, `${o}（CMS 已刪除）`])]
          .map(([v, l]) => `<option value="${esc(v)}">${esc(l)}</option>`).join('');
        sel.value = current;
        const termSel = filters.elements.namedItem('term') as HTMLSelectElement;
        const currentTerm = termSel.value;
        termSel.innerHTML = '<option value="">全部梯次</option>' + legacy_terms.map((t) => `<option value="${esc(t.term)}">${esc(t.term)}（${t.n}）</option>`).join('');
        termSel.value = currentTerm;
        $('orphans').classList.toggle('hidden', !orphans.length);
        $('orphans').textContent = orphans.length ? `⚠️ 以下時段已從 CMS 刪除或改了代號，但仍有報名資料：${orphans.join('、')}。請到 CMS 恢復該時段。` : '';
      }

      function row(r: Reg): string {
        const statusOptions = config.statuses.map((s) => `<option ${s === r.status ? 'selected' : ''}>${esc(s)}</option>`).join('');
        const paid = ['已付費', '合庫轉帳', '現金繳清'].includes(r.status);
        const legacy = !!r.legacy_term;
        const vaInfo = legacy
          ? `<div class="font-mono">${esc(r.legacy_va)}</div><div class="text-xs text-ink-500">舊站帳號</div>`
          : r.va_account
          ? `<div class="font-mono">${esc(r.va_account)}</div><div class="text-xs ${r.expired ? 'font-bold text-red-600' : 'text-ink-500'}">${r.expired ? '已逾期 ' : '期限 '}${tw(r.va_expires_at)}</div>`
          : '<div class="text-xs text-ink-500">候補不產生帳號</div>';
        const discount = r.discount_amount ? `<div class="text-xs font-bold text-yellow-700">優待 ${money(r.discount_amount)}</div>` : '';
        const mockBtn = config.payment_mode === 'mock' && r.va_account && !paid
          ? `<button data-mock="${r.id}" class="rounded-lg bg-green-600 px-2 py-1 text-xs font-bold text-white hover:bg-green-700">模擬入帳</button>` : '';
        const review = r.review_note
          ? `<div class="mt-1 rounded-lg bg-red-50 px-2 py-1 text-xs font-bold text-red-700">⚠️ 需人工確認：${esc(r.review_note)}</div>` : '';
        return `<tr class="align-top ${r.status === '取消報名' ? 'opacity-50' : ''} ${r.review_note ? 'bg-red-50/40' : ''}">
          <td class="px-3 py-3 font-bold">${r.id}</td>
          <td class="px-3 py-3 whitespace-nowrap">${legacy ? `<span class="rounded bg-slate-200 px-1.5 py-0.5 text-xs">舊站 ${esc(r.legacy_term)}</span>` : tw(r.created_at)}</td>
          <td class="px-3 py-3"><div class="text-xs text-ink-500">${esc(r.course_title)}</div>${esc(r.session_name)}</td>
          <td class="px-3 py-3"><button type="button" data-profile="${r.id}" class="font-bold text-brand-700 underline decoration-dotted hover:decoration-solid">${esc(r.student_name)}</button>${r.gender ? `<span class="ml-1 text-xs text-ink-500">${esc(r.gender)}</span>` : ''}<div class="text-ink-500">${esc(r.parent_name)}</div></td>
          <td class="px-3 py-3">${esc(r.school)}<div class="text-ink-500">${esc(r.grade)}</div></td>
          <td class="px-3 py-3"><div>${esc(r.phone)}</div>${r.tel ? `<div class="text-ink-500">${esc(r.tel)}</div>` : ''}<div class="text-ink-500">${esc(r.email)}</div>${r.note ? `<div class="mt-1 text-xs text-ink-500">備註：${esc(r.note)}</div>` : ''}</td>
          <td class="px-3 py-3"><select data-admission="${r.id}" ${legacy ? 'disabled title="舊站資料不能修改"' : ''} class="rounded-lg border border-black/15 px-2 py-1 disabled:opacity-60 ${r.admission === '候補' ? 'bg-yellow-50' : ''}">
            <option ${r.admission === '正取' ? 'selected' : ''}>正取</option><option ${r.admission === '候補' ? 'selected' : ''}>候補</option></select></td>
          <td class="px-3 py-3"><select data-status="${r.id}" class="rounded-lg border border-black/15 px-2 py-1 ${paid ? 'bg-green-50' : ''}">${statusOptions}</select>
            ${r.paid_at ? `<div class="mt-1 text-xs ${paid ? 'text-green-700' : 'text-red-700'}">入帳 ${money(r.paid_amount)}・${tw(r.paid_at)}</div>` : ''}${review}</td>
          <td class="px-3 py-3"><div class="font-bold">${legacy ? '' : money(r.amount)}</div>${discount}${vaInfo}</td>
          <td class="space-y-1 px-3 py-3"><div class="flex flex-wrap gap-1">${mockBtn}
            <button data-history="${r.id}" class="rounded-lg border border-black/15 px-2 py-1 text-xs hover:bg-slate-100">紀錄</button></div></td>
        </tr>`;
      }

      async function loadRows() {
        const rows = await api<Reg[]>(`/registrations?${query()}`);
        currentRows = new Map(rows.map((r) => [r.id, r]));
        $('rows').innerHTML = rows.map(row).join('');
        $('empty').classList.toggle('hidden', rows.length > 0);
        $('count').textContent = `共 ${rows.length} 筆`;
      }

      const refresh = () => Promise.all([loadSessions(), loadRows(), loadAudit()]).catch((e) => alert(e.message));

      async function update(id: string, body: Record<string, string>, confirmText?: string) {
        if (confirmText && !confirm(confirmText)) return refresh();
        try {
          await api(`/registrations/${id}`, { method: 'PATCH', body: JSON.stringify(body) });
        } catch (e) {
          alert((e as Error).message);
        }
        refresh();
      }

      document.addEventListener('change', (e) => {
        const el = e.target as HTMLSelectElement;
        if (el.dataset.status) update(el.dataset.status, { status: el.value });
        if (el.dataset.admission) {
          const msg = el.value === '正取'
            ? '確定將這筆候補遞補為正取？系統會產生繳費帳號，並以簡訊與 Email 通知家長。'
            : '確定改為候補？原繳費帳號會立即失效。';
          update(el.dataset.admission, { admission: el.value }, msg);
        }
      });

      document.addEventListener('click', async (e) => {
        const preview = (e.target as HTMLElement).closest<HTMLElement>('[data-preview]');
        if (preview) {
          sendTestEmail(preview.dataset.preview);
          return;
        }
        const profileBtn = (e.target as HTMLElement).closest<HTMLElement>('[data-profile]');
        if (profileBtn) {
          showProfile(Number(profileBtn.dataset.profile));
          return;
        }
        if ((e.target as HTMLElement).closest('[data-close-profile]')) {
          $<HTMLDialogElement>('profile').close();
          return;
        }
        const el = (e.target as HTMLElement).closest<HTMLElement>('[data-mock],[data-history],[data-filter-session],[data-close]');
        if (!el) return;
        if (el.dataset.mock) {
          if (!confirm('模擬台新入帳通知（測試用）：這筆報名會被標記為已付費，並記錄收據通知。')) return;
          try {
            const out = await api<{ result: string }>(`/registrations/${el.dataset.mock}/mock-payment`, { method: 'POST', body: '{}' });
            const labels: Record<string, string> = { paid: '對帳成功，已改為已付費', paid_late: '逾期後才入帳，已標記需人工確認', amount_mismatch: '金額不符，已標記需人工確認', unmatched: '查無帳號', already_paid: '已付費過（重複繳費），已標記需人工確認', not_payable: '報名非正取或已取消，已標記需人工確認', duplicate_event: '重複的入帳通知' };
            alert(labels[out.result] ?? out.result);
          } catch (err) {
            alert((err as Error).message);
          }
          refresh();
        }
        if (el.dataset.history) showHistory(el.dataset.history);
        if (el.dataset.filterSession !== undefined) {
          (filters.elements.namedItem('session') as HTMLSelectElement).value = el.dataset.filterSession;
          loadRows();
        }
        if (el.dataset.close !== undefined) $<HTMLDialogElement>('history').close();
      });

      // ---- 報名資料（點學生姓名）----
      let currentRows = new Map<number, Reg>();
      let profileId = 0;
      const GRADES = ['幼兒園大班', '國小一年級', '國小二年級', '國小三年級', '國小四年級', '國小五年級', '國小六年級', '國中一年級', '國中二年級', '國中三年級'];
      // 欄位依報名表順序；select 的選項保留舊站資料原本的值
      const profileFields: { name: keyof Reg; label: string; type?: 'select' | 'textarea'; options?: string[]; wide?: boolean }[] = [
        { name: 'student_name', label: '學生姓名' },
        { name: 'gender', label: '性別', type: 'select', options: ['男', '女'] },
        { name: 'school', label: '就讀學校' },
        { name: 'grade', label: '目前就讀年級', type: 'select', options: GRADES },
        { name: 'parent_name', label: '家長姓名' },
        { name: 'tel', label: '聯絡電話' },
        { name: 'phone', label: '行動電話' },
        { name: 'email', label: 'Email' },
        { name: 'diet', label: '飲食習慣', type: 'select', options: ['葷', '方便素'] },
        { name: 'zip', label: '郵遞區號' },
        { name: 'address', label: '地址', wide: true },
        { name: 'note', label: '學生狀況說明／備註', type: 'textarea', wide: true },
      ];
      const fieldCls = 'mt-1 block w-full rounded-lg border border-black/15 px-3 py-2';

      function showProfile(id: number) {
        const r = currentRows.get(id);
        if (!r) return;
        profileId = id;
        $('profile-title').textContent = `報名資料｜#${r.id} ${r.student_name}`;
        const info: [string, string][] = [
          ['報名編號', String(r.id)],
          ['報名時間', r.legacy_term ? `舊站匯入（${r.legacy_term} 第 ${r.legacy_id} 筆）` : tw(r.created_at)],
          ['課程', r.course_title],
          ['時段', r.session_name],
          ['正取／候補', r.admission],
          ['狀態', r.expired ? '等待付費（已逾期）' : r.status],
          ['應繳金額', r.legacy_term ? '（舊站資料無金額）' : money(r.amount)],
          ['繳費帳號', r.va_account ?? (r.legacy_va ? `${r.legacy_va}（舊站）` : '')],
          ['同意辦法', r.agreed_policies ?? ''],
        ];
        $('profile-info').innerHTML = info
          .filter(([, v]) => v)
          .map(([k, v]) => `<div class="flex gap-2"><dt class="w-20 shrink-0 text-ink-500">${k}</dt><dd class="font-bold">${esc(v)}</dd></div>`)
          .join('');
        $('profile-fields').innerHTML = profileFields
          .map((f) => {
            const value = (r[f.name] as string | null) ?? '';
            let control: string;
            if (f.type === 'select') {
              const options = f.options!.includes(value) || !value ? f.options! : [value, ...f.options!];
              control = `<select name="${f.name}" class="${fieldCls}"><option value="">（未填）</option>${options
                .map((o) => `<option ${o === value ? 'selected' : ''}>${esc(o)}</option>`).join('')}</select>`;
            } else if (f.type === 'textarea') {
              control = `<textarea name="${f.name}" rows="3" class="${fieldCls}">${esc(value)}</textarea>`;
            } else {
              control = `<input name="${f.name}" value="${esc(value)}" class="${fieldCls}" />`;
            }
            return `<label class="block font-bold ${f.wide ? 'sm:col-span-2' : ''}">${f.label}${control}</label>`;
          })
          .join('');
        ($<HTMLFormElement>('profile-form').elements.namedItem('discount_amount') as HTMLInputElement).value = r.discount_amount == null ? '' : String(r.discount_amount);
        $('profile-error').classList.add('hidden');
        $<HTMLDialogElement>('profile').showModal();
      }

      $('profile-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const data = Object.fromEntries(new FormData(e.currentTarget as HTMLFormElement));
        try {
          await api(`/registrations/${profileId}/profile`, { method: 'PATCH', body: JSON.stringify(data) });
          $<HTMLDialogElement>('profile').close();
          refresh();
        } catch (err) {
          $('profile-error').textContent = (err as Error).message;
          $('profile-error').classList.remove('hidden');
        }
      });

      async function showHistory(id: string) {
        const h = await api<{ notifications: any[]; payments: any[]; audit: any[] }>(`/registrations/${id}/history`);
        const resultLabel: Record<string, string> = { mock: '測試模式（未寄出）', sent: '已寄出', failed: '寄送失敗' };
        const section = (title: string, items: string[]) =>
          `<div><h4 class="mb-2 font-bold">${title}</h4>${items.length ? items.join('') : '<p class="text-ink-500">無</p>'}</div>`;
        $('history-title').textContent = `報名編號 ${id} 的紀錄`;
        $('history-body').innerHTML = [
          section('通知（Email／簡訊）', h.notifications.map((n) => `<div class="mb-3 rounded-xl bg-slate-50 p-3">
            <p class="flex flex-wrap items-center gap-2 text-xs text-ink-500">${tw(n.created_at)}・${n.channel === 'email' ? 'Email' : '簡訊'} → ${esc(n.recipient)}・<b>${resultLabel[n.result] ?? esc(n.result)}</b>
              ${n.channel === 'email' ? `<button type="button" data-preview="${n.id}" class="rounded border border-black/15 bg-white px-2 py-0.5 text-ink-700 hover:bg-slate-100">寄一份給我看</button>` : ''}</p>
            ${n.subject ? `<p class="mt-1 font-bold">${esc(n.subject)}</p>` : ''}
            ${n.html
              ? `<iframe sandbox="" srcdoc="${esc(n.html)}" title="信件預覽" class="mt-2 h-[520px] w-full rounded-lg border border-black/10 bg-white"></iframe>
                 <details class="mt-2"><summary class="cursor-pointer text-xs text-ink-500">純文字版</summary><pre class="mt-1 font-sans whitespace-pre-wrap">${esc(n.body)}</pre></details>`
              : `<pre class="mt-1 font-sans whitespace-pre-wrap">${esc(n.body)}</pre>`}</div>`)),
          section('入帳紀錄', h.payments.map((p) => `<p class="mb-1">${tw(p.created_at)}・${money(p.amount)}・${esc(p.result)}・序號 ${esc(p.ref)}</p>`)),
          section('操作紀錄', h.audit.map((a) => `<p class="mb-1">${tw(a.created_at)}・${esc(a.actor)}・${esc(a.action)}：${esc(a.detail)}</p>`)),
        ].join('');
        $<HTMLDialogElement>('history').showModal();
      }

      // ---- 操作紀錄 ----
      interface AuditItem { id: number; registration_id: number | null; actor: string; action: string; detail: string | null; created_at: string; student_name: string | null; session_name: string | null }
      const actorLabel = (a: string) => (a === 'system' ? '系統（自動對帳）' : a.replace(/^password:/, ''));
      let auditLastId = 0;
      async function loadAudit(more = false) {
        const params = new URLSearchParams({ limit: '50' });
        const actor = $<HTMLSelectElement>('audit-actor').value;
        if (actor) params.set('actor', actor);
        if (more && auditLastId) params.set('before', String(auditLastId));
        const { items, actors } = await api<{ items: AuditItem[]; actors: string[] }>(`/audit?${params}`);
        const html = items
          .map(
            (a) => `<tr class="align-top">
              <td class="px-3 py-2 whitespace-nowrap">${tw(a.created_at)}</td>
              <td class="px-3 py-2">${esc(actorLabel(a.actor))}</td>
              <td class="px-3 py-2 whitespace-nowrap font-bold">${esc(a.action)}</td>
              <td class="px-3 py-2">${a.registration_id ? `<button type="button" data-history="${a.registration_id}" class="text-brand-700 underline">#${a.registration_id} ${esc(a.student_name)}</button>` : ''}</td>
              <td class="px-3 py-2">${esc(a.detail)}</td>
            </tr>`,
          )
          .join('');
        $('audit-rows').innerHTML = more ? $('audit-rows').innerHTML + html : html || '<tr><td colspan="5" class="px-3 py-6 text-center text-ink-500">沒有紀錄</td></tr>';
        if (items.length) auditLastId = items[items.length - 1].id;
        $('audit-more').classList.toggle('hidden', items.length < 50);
        const sel = $<HTMLSelectElement>('audit-actor');
        if (sel.options.length <= 1) sel.insertAdjacentHTML('beforeend', actors.map((x) => `<option value="${esc(x)}">${esc(actorLabel(x))}</option>`).join(''));
      }
      $('audit-actor').addEventListener('change', () => loadAudit());
      $('audit-refresh').addEventListener('click', () => loadAudit());
      $('audit-more').addEventListener('click', () => loadAudit(true));

      filters.addEventListener('submit', (e) => {
        e.preventDefault();
        loadRows();
      });
      $('export').addEventListener('click', () => (location.href = `/api/admin/export.csv?${query()}`));

      // 發測試簡訊：確認三竹串接（會真的發出並扣點數）
      $('test-sms').addEventListener('click', async () => {
        const to = prompt('發一則測試簡訊到哪支手機？（會真的發出並扣三竹點數）');
        if (!to) return;
        try {
          const out = await api<{ account_point: number | null }>('/test-sms', { method: 'POST', body: JSON.stringify({ to }) });
          alert(`已發送${out.account_point !== null ? `，三竹剩餘點數 ${out.account_point}` : ''}`);
        } catch (e) {
          alert(`發送失敗：${(e as Error).message}`);
        }
      });

      // 寄測試信／預覽通知信：用 Brevo 真的寄出一封（不論是否為測試模式）
      // 寄件人需先在 Brevo 驗證過；網域驗證完成前，可以先用自己驗證過的信箱當寄件人
      const remember = (key: string, value?: string) => {
        try {
          if (value !== undefined) localStorage.setItem(key, value);
          return localStorage.getItem(key) ?? '';
        } catch {
          return value ?? '';
        }
      };
      async function sendTestEmail(notificationId?: string) {
        const to = prompt('寄到哪個 Email？（會真的寄出）', remember('test-email-to'));
        if (!to) return;
        const from = prompt('寄件人（需在 Brevo 驗證過；留空則用「故事講堂 <service@storykids.com.tw>」）', remember('test-email-from'));
        if (from === null) return;
        remember('test-email-to', to);
        remember('test-email-from', from);
        try {
          await api('/test-email', {
            method: 'POST',
            body: JSON.stringify({ to, from: from || undefined, notification_id: notificationId ? Number(notificationId) : undefined }),
          });
          alert(`已寄出，請到 ${to} 收信（也看一下垃圾信件匣）`);
        } catch (e) {
          alert(`寄送失敗：${(e as Error).message}`);
        }
      }
      $('test-email').addEventListener('click', () => sendTestEmail());

      (async () => {
        try {
          config = await api('/config');
        } catch (e) {
          document.querySelector('main')!.innerHTML = `<p class="rounded-xl bg-red-50 p-4 text-red-700">${esc((e as Error).message)}</p>`;
          return;
        }
        $('actor').textContent = `登入：${config.actor}`;
        if (config.sms_points !== null) {
          $('sms-points').textContent = `簡訊點數 ${config.sms_points}`;
          $('sms-points').classList.toggle('text-red-600', config.sms_points < 200);
          $('sms-points').classList.remove('hidden');
        }
        const modes = [config.payment_mode, config.mail_mode, config.sms_mode];
        if (modes.includes('mock')) {
          $('mode-badge').textContent = '測試模式：繳費帳號為假資料、Email 與簡訊不會寄出（可在「紀錄」查看內容）';
          $('mode-badge').classList.remove('hidden');
        }
        const statusSel = filters.elements.namedItem('status') as HTMLSelectElement;
        statusSel.insertAdjacentHTML('beforeend', config.statuses.map((s) => `<option>${esc(s)}</option>`).join(''));
        refresh();
      })();
    </script>
  </body>
</html>
