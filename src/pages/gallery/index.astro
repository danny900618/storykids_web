---
// 幫孩子鼓掌：沿用舊站版型
// - 最上方：只有影片、沒有照片的項目直接嵌入播放
// - 其餘：一半圖片、一半文字，左右交錯排列（StoryRow）
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import StoryRow from '../../components/StoryRow.astro';
import { getGalleryVideos, getGalleryStories } from '../../lib/content';
import { youtubeId } from '../../lib/site';

const videos = await getGalleryVideos();
const stories = await getGalleryStories();
---

<BaseLayout title="幫孩子鼓掌">
  <PageHeader title="幫孩子鼓掌" subtitle="記錄孩子在講堂的每一次勇敢上台" crumbs={[{ label: '幫孩子鼓掌', href: '/gallery' }]} />

  {
    videos.length > 0 && (
      <section class="container-page max-w-4xl pt-12">
        {videos.map((v) => (
          <div class="mb-6 aspect-video overflow-hidden rounded-2xl bg-black shadow-sm">
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${youtubeId(v.data.youtube)}?rel=0`}
              title={v.data.title}
              class="size-full"
              loading="lazy"
              allow="accelerometer; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            />
          </div>
        ))}
      </section>
    )
  }

  <section class="container-page max-w-5xl space-y-8 py-12">
    {stories.map((item, i) => <StoryRow item={item} reverse={i % 2 === 1} />)}
    {videos.length + stories.length === 0 && <p class="text-ink-500">內容整理中。</p>}
  </section>
</BaseLayout>
