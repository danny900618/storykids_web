---
// 內頁標題區：麵包屑 + 標題
interface Props {
  title: string;
  subtitle?: string;
  crumbs?: { label: string; href: string }[];
}
const { title, subtitle, crumbs = [] } = Astro.props;
---

<section class="bg-gradient-to-b from-brand-50 to-cream">
  <div class="container-page py-10 sm:py-14">
    <nav aria-label="麵包屑" class="text-sm text-ink-500">
      <ol class="flex flex-wrap items-center gap-1">
        <li><a href="/" class="hover:text-brand-700">首頁</a></li>
        {
          crumbs.map((c) => (
            <li class="flex items-center gap-1">
              <span aria-hidden="true">›</span>
              <a href={c.href} class="hover:text-brand-700">{c.label}</a>
            </li>
          ))
        }
      </ol>
    </nav>
    <h1 class="mt-3 text-3xl font-bold text-ink-900 sm:text-4xl">{title}</h1>
    {subtitle && <p class="mt-3 max-w-2xl text-ink-500">{subtitle}</p>}
  </div>
</section>
