---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { courseRegistrationHref, isExternal } from '../lib/site';

interface Props {
  course: CollectionEntry<'courses'>;
}
const { course } = Astro.props;
const { title, category, audience, summary, cover } = course.data;
const regHref = courseRegistrationHref(course);
---

<article class="card flex flex-col">
  <a href={`/courses/${course.id}`} class="block">
    {
      cover ? (
        <img src={cover} alt="" loading="lazy" class="aspect-[4/3] w-full object-cover" />
      ) : (
        <div class="grid aspect-[4/3] place-items-center bg-brand-100 text-4xl font-bold text-brand-600">{title.slice(0, 2)}</div>
      )
    }
  </a>
  <div class="flex flex-1 flex-col p-5">
    <div class="flex flex-wrap gap-2 text-xs font-bold">
      <span class="rounded-full bg-brand-100 px-2.5 py-1 text-brand-700">{category}</span>
      {audience && <span class="rounded-full bg-ink-900/5 px-2.5 py-1 text-ink-700">{audience}</span>}
    </div>
    <h3 class="mt-3 text-xl font-bold">
      <a href={`/courses/${course.id}`} class="hover:text-brand-700">{title}</a>
    </h3>
    {summary && <p class="mt-2 line-clamp-3 flex-1 text-sm text-ink-500">{summary}</p>}
    <div class="mt-5 flex gap-2">
      <a href={`/courses/${course.id}`} class="btn-outline flex-1 text-sm">課程詳情</a>
      <a href={regHref} class="btn-primary flex-1 text-sm" {...(isExternal(regHref) ? { target: '_blank', rel: 'noopener' } : {})}>
        <Icon name="pencil" class="size-4" />
        立即報名
      </a>
    </div>
  </div>
</article>
