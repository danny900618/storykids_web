---
// 課程頁的「上課時段」：名稱、時間、費用與報名按鈕（不顯示名額與剩餘名額）
// 額滿時按鈕改為「額滿請候補」（即時向後端查詢），仍可報名，會自動列為候補（不產生繳費帳號）
import type { CollectionEntry } from 'astro:content';
import { earlyBirdUntil } from '../lib/site';

interface Props {
  sessions: CollectionEntry<'courses'>['data']['sessions'];
  defaultLocation?: string; // 時段沒有填上課地點時使用
}
const { sessions, defaultLocation } = Astro.props;
const money = (n: number) => `NT$ ${n.toLocaleString('en-US')}`;
// 早鳥期限（建置時已過期的不顯示；建置後才過期的，由下方程式在瀏覽器切回原價）
const now = new Date().toISOString();
const earlyBird = (s: (typeof sessions)[number]) => {
  const until = earlyBirdUntil(s);
  return until && until > now ? { until, price: s.price - s.early_bird_discount!, date: until.slice(0, 10) } : undefined;
};
const twDate = (iso: string) => {
  const d = new Date(new Date(iso).getTime() + 8 * 3600_000);
  return `${d.getUTCMonth() + 1}/${d.getUTCDate()}`;
};
---

<section id="sessions" class="scroll-mt-28">
  <h2 class="border-l-[6px] border-brand-500 pl-3 text-xl font-bold sm:text-2xl">上課時段</h2>
  <p class="mt-2 text-sm text-ink-500">名額有限，額滿後仍可報名並自動列為候補，如有名額釋出將主動通知。</p>
  <ul class="mt-6 space-y-4">
    {
      sessions.map((s) => (
        <li class="flex flex-col gap-4 rounded-2xl bg-white p-5 shadow-sm ring-1 ring-black/5 sm:flex-row sm:items-center" data-session={s.code ?? ''}>
          <div class="flex-1">
            <p class="text-lg font-bold text-ink-900">{s.name}</p>
            {(s.period || s.time) && (
              <p class="mt-1 text-ink-700">
                <span class="text-sm text-ink-500">上課期間：</span>
                {[s.period, s.time].filter(Boolean).join('　')}
              </p>
            )}
            {(s.location || defaultLocation) && (
              <p class="mt-0.5 text-ink-700">
                <span class="text-sm text-ink-500">上課地點：</span>
                {s.location || defaultLocation}
              </p>
            )}
            <p class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
              {earlyBird(s) ? (
                <>
                  <span class="font-bold text-brand-700" data-regular-price hidden>{money(s.price)}</span>
                  <span class="flex flex-wrap items-baseline gap-x-2" data-early-bird={earlyBird(s)!.until}>
                    <span class="rounded-full bg-brand-600 px-2 py-0.5 text-xs font-bold text-white">早鳥</span>
                    <span class="text-base font-bold text-brand-700">{money(earlyBird(s)!.price)}</span>
                    <span class="text-ink-500 line-through">{money(s.price)}</span>
                    <span class="text-brand-700">{twDate(earlyBird(s)!.until)} 前報名</span>
                  </span>
                </>
              ) : (
                <span class="font-bold text-brand-700">{money(s.price)}</span>
              )}
              <span class="font-bold text-brand-600" data-full />
            </p>
          </div>
          {s.open && s.code ? (
            <a href={`/register?session=${encodeURIComponent(s.code!)}`} class="btn-primary shrink-0 px-6" data-register>
              我要預約
            </a>
          ) : (
            <span class="shrink-0 rounded-full bg-ink-900/5 px-5 py-2.5 text-center font-bold text-ink-500">暫停報名</span>
          )}
        </li>
      ))
    }
  </ul>
</section>

<script>
  // 向後端查詢哪些時段已額滿
  async function loadAvailability() {
    const items = document.querySelectorAll<HTMLElement>('[data-session]');
    if (!items.length) return;
    try {
      const res = await fetch('/api/availability', { cache: 'no-store' });
      if (!res.ok) return;
      const data = (await res.json()) as Record<string, { full: boolean }>;
      for (const el of items) {
        if (!data[el.dataset.session!]?.full) continue;
        el.querySelector('[data-full]')!.textContent = '已額滿';
        const button = el.querySelector<HTMLAnchorElement>('[data-register]');
        if (button) button.textContent = '額滿請候補';
      }
    } catch {
      // 查詢失敗時照常顯示「我要預約」，送出後由後端判斷正取或候補
    }
  }
  loadAvailability();

  // 早鳥過了截止日（網站建置後才過期）：切回原價
  document.querySelectorAll<HTMLElement>('[data-early-bird]').forEach((el) => {
    if (new Date().toISOString() <= el.dataset.earlyBird!) return;
    el.hidden = true;
    el.parentElement?.querySelector<HTMLElement>('[data-regular-price]')?.removeAttribute('hidden');
  });
</script>
